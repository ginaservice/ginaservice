{
  "name": "ginaservice",
  "version": "1.0.0",
  "private": true,
  "description": "🧬 GinaService — منصة الخدمات المتكاملة | Amazon-Grade Platform",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:load": "k6 run tests/load/main.js",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rimraf node_modules",
    "generate:api": "turbo generate:api",
    "db:migrate": "turbo db:migrate",
    "docker:up": "docker-compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infra/docker/docker-compose.yml down",
    "release": "changeset publish"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@playwright/test": "^1.43.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
