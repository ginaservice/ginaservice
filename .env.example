# =====================================================
# GinaService — Environment Variables Template
# Amazon-grade configuration management
# =====================================================

# ── PLATFORM ───────────────────────────────────────
NODE_ENV=development
PLATFORM_NAME=ginaservice
PLATFORM_VERSION=1.0.0
DEPLOYMENT_ENV=development

# ── API GATEWAY ────────────────────────────────────
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0

# ── INTERNAL SERVICE URLS ──────────────────────────
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
PAY_SERVICE_URL=http://localhost:3003
NOTIF_SERVICE_URL=http://localhost:3004
ANALYTICS_URL=http://localhost:3005
CHAMELEON_URL=http://localhost:3006

# ── SECURITY ──────────────────────────────────────
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM_STRING
JWT_ACCESS_TTL=900        # 15 minutes in seconds
JWT_REFRESH_TTL=604800    # 7 days in seconds
ENCRYPTION_KEY=CHANGE_ME_EXACTLY_32_BYTES_HEX_STRING_HERE
WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SIGNING_SECRET
AUDIT_SIGNING_KEY=CHANGE_ME_AUDIT_LOG_SIGNING_KEY

# ── DATABASE ───────────────────────────────────────
DATABASE_URL=postgresql://gina:gina_dev_pass@localhost:5432/gina_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_SSL=false
DB_PASSWORD=gina_dev_pass

# ── REDIS ──────────────────────────────────────────
REDIS_URL=redis://:gina_redis_pass@localhost:6379
REDIS_PASSWORD=gina_redis_pass
REDIS_TLS=false

# ── FIREBASE ───────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ── GOOGLE (AI / CLOUD) ────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret

# ── GINA PAY ──────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
GINA_PAY_MERCHANT_ID=your-merchant-id
GINA_PAY_WEBHOOK_SECRET=your-ginpay-webhook-secret

# ── NOTIFICATIONS ──────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@ginaservice.com
TWILIO_ACCOUNT_SID=ACyour_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890
FCM_SERVER_KEY=your_firebase_cloud_messaging_key

# ── MONITORING ─────────────────────────────────────
GRAFANA_PASSWORD=gina_admin
SENTRY_DSN=https://your@sentry.io/project
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ── RATE LIMITING ──────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_PAY_MAX=100
RATE_LIMIT_PAY_WINDOW_MS=3600000

# ── FRONTEND (Vite) ────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=GinaService
VITE_ENV=development
VITE_FIREBASE_API_KEY=${FIREBASE_API_KEY}
VITE_FIREBASE_AUTH_DOMAIN=${FIREBASE_AUTH_DOMAIN}
VITE_FIREBASE_PROJECT_ID=${FIREBASE_PROJECT_ID}
VITE_STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}
VITE_SENTRY_DSN=${SENTRY_DSN}
